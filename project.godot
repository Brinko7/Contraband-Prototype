; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="contraband-prototype"
run/main_scene="res://scenes/GuildHQ.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://GameManager.gd"
AudioManager="*res://AudioManager.gd"
LootSystem="*res://LootSystem.gd"
WeaponDatabase="*res://data/WeaponDatabase.gd"
ClassDatabase="*res://data/ClassDatabase.gd"
MetaProgress="*res://systems/MetaProgress.gd"
CombatSystem="*res://systems/CombatSystem.gd"
StealthSystem="*res://systems/StealthSystem.gd"
StatusEffectManager="*res://StatusEffectManager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gemini_godot/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

[godot_ai]

server_port=8080

